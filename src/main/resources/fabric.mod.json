{
  "schemaVersion": 1,
  "id": "crispscale",
  "version": "${version}",

  "name": "CrispScale",
  "description": "Extended GUI scale with smooth font rendering! Fork of Advanced UI Scaling.",
  "authors": [
    "Rose",
    "Qendolin"
  ],
  "contact": {
    "homepage": "https://github.com/krekl1n/CrispScale",
    "sources": "https://github.com/krekl1n/CrispScale",
    "issues": "https://github.com/krekl1n/CrispScale/issues"
  },

  "license": "CC0-1.0",
  "icon": "assets/crispscale/icon.png",

  "environment": "*",
